# --- Server (Node / Vercel serverless) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=replace-with-service-role-key
SUPABASE_PROJECT_REF=your-project-ref

# Stripe (used by /api/create-checkout)
STRIPE_SECRET_KEY=sk_test_xxx

# Asaas (used by /api/create-subscription, /api/buy-product, /api/webhook)
ASAAS_API_KEY=replace-with-asaas-key
ASAAS_API_BASE=https://api.asaas.com/v3
ASAAS_WEBHOOK_SECRET=replace-with-strong-random

# Setup endpoint (used by /api/setup-machine-table)
SETUP_MACHINE_TABLE_KEY=replace-with-strong-random

# AI (used by /api/chat-ai, /api/chat-shop)
AI_PROVIDER=groq
GROQ_API_KEY=gsk_xxx
HF_TOKEN=hf_xxx
GEMINI_API_KEY=replace-with-gemini-key
OLLAMA_BASE_URL=http://localhost:11434

BASE_URL=https://your-site.vercel.app

# --- Client (Vite - prefixed with VITE_) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-anon-key
VITE_ADMIN_EMAILS=you@example.com,other@example.com
VITE_BASE_URL=https://your-site.vercel.app

# --- Admin credentials for ops scripts (DO NOT commit real values) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-strong-password-min-12-chars
